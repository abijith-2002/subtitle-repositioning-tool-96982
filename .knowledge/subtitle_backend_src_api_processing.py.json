{"is_source_file": true, "format": "Python", "description": "This source file provides utilities for processing and repositioning subtitles (SRT, ASS, SSA, VTT) within video files. It includes functions to detect subtitle position using OCR, normalize subtitle formatting, parse subtitle files, and modify alignment tags to improve subtitle placement based on visual detection of burnt-in text. The module leverages OpenCV, numpy, srt parsing, and a machine learning OCR engine (RapidOCR) for detection, along with multithreaded processing for efficiency.", "external_files": ["cv2", "numpy", "srt", "rapidocr_onnxruntime"], "external_methods": ["cv2.VideoCapture", "cv2.cvtColor", "cv2.adaptiveThreshold", "cv2.CAP_PROP_FPS", "cv2.CAP_PROP_FRAME_HEIGHT", "cv2.CAP_PROP_FRAME_COUNT"], "published": ["process_subtitle"], "classes": [{"name": "VideoContext", "description": "A class that manages a reusable VideoCapture object and caches video properties to optimize frame reading and seeking during subtitle position detection."}], "methods": [{"name": "cv2.VideoCapture _safe_video_capture(path: str)", "description": "Safely opens a video file with OpenCV VideoCapture, raising an error if it cannot be opened.", "scope": "", "scopeKind": ""}, {"name": "detect_using_rapidocr(img: np.ndarray)", "description": "Runs OCR detection on an image using the RapidOCR engine, returning detected text boxes, texts, and scores.", "scope": "", "scopeKind": ""}, {"name": "str to_ass_timestamp_from_timedelta(td: timedelta)", "description": "Converts a timedelta object into an ASS subtitle timestamp string (H:MM:SS.CC format).", "scope": "", "scopeKind": ""}, {"name": "np.ndarray preprocess_adaptive_threshold(image: np.ndarray)", "description": "Prepares an image for OCR by converting to grayscale, equalizing histogram, and applying adaptive thresholding.", "scope": "", "scopeKind": ""}, {"name": "str decide_subtitle_position(filtered_detections_list, frame_height: int, bottom_threshold_ratio: float = 0.75)", "description": "Determines if subtitles are best positioned at the top or bottom based on OCR detection of burnt-in text, using vectorized y-average calculation.", "scope": "", "scopeKind": ""}, {"name": "np.ndarray _compute_frame_indices(start_frame: int, end_frame: int, min_samples: int, max_frame_count: int)", "description": "Calculates sample frame indices within a segment, clipped to the video frame range, to optimize OCR sampling.", "scope": "", "scopeKind": ""}, {"name": "str _cached_segment_position(video_path: str, start_sec: float, end_sec: float, min_frames: int)", "description": "LRU-cache decorated function that caches the decision of subtitle position for a video segment to avoid recomputation.", "scope": "", "scopeKind": ""}, {"name": "str _decide_position_with_context(ctx: VideoContext, start_sec: float, end_sec: float, min_frames: int = 3)", "description": "Uses a reusable VideoContext to analyze sampled frames and determine subtitle position (top or bottom).", "scope": "", "scopeKind": ""}, {"name": "str get_position_for_segment(video_path: str, start_sec: float, end_sec: float, min_frames: int = 3)", "description": "Public function to determine whether to position subtitles at top or bottom for a specific segment, using caching for efficiency.", "scope": "", "scopeKind": ""}, {"name": "_parse_srt_file(path: str)", "description": "Parses an SRT subtitle file into a list of subtitle entries.", "scope": "", "scopeKind": ""}, {"name": "str _normalize_ass_alignment_tags(text: str)", "description": "Fixes malformed ASS alignment tags within subtitle text to ensure correct positioning.", "scope": "", "scopeKind": ""}, {"name": "reposition_srt(video_path, srt_path, output_ass_path, min_frames=3, max_workers=5)", "description": "Repositions subtitles in an SRT file based on OCR detection, and outputs an ASS file with updated alignment tags.", "scope": "", "scopeKind": ""}, {"name": "reposition_ass(video_path, ass_path, output_ass_path, max_workers