{"is_source_file": true, "format": "Python", "description": "This file provides utilities for processing and repositioning subtitles (SRT, ASS, SSA, VTT) based on visual analysis of videos. It includes functions for detecting burnt-in and on-screen subtitles using OCR, parsing various subtitle formats, and adjusting subtitle positioning tags accordingly. The main function `process_subtitle` orchestrates the analysis by reading subtitle files, sampling video frames, and applying detection results to modify subtitle position tags for better alignment.", "external_files": ["cv2", "numpy", "srt"], "external_methods": ["RapidOCR (from rapidocr_onnxruntime)", "cv2.VideoCapture", "cv2.cvtColor", "cv2.adaptiveThreshold", "cv2.equalizeHist"], "published": ["process_subtitle"], "classes": [{"name": "VideoContext", "description": "A helper class that manages a cached video capture object and properties such as FPS, height, and frame count to efficiently sample frames for analysis."}], "methods": [{"name": "cv2.VideoCapture _safe_video_capture(path: str)", "description": "Opens a video file with OpenCV and raises an error if unable to do so.", "scope": "", "scopeKind": ""}, {"name": "detect_using_rapidocr(img: np.ndarray)", "description": "Runs OCR detection on an image using RapidOCR; returns detection results or empty list if OCR engine is unavailable.", "scope": "", "scopeKind": ""}, {"name": "str to_ass_timestamp_from_timedelta(td: timedelta)", "description": "Converts a timedelta object to an ASS subtitle timestamp string.", "scope": "", "scopeKind": ""}, {"name": "np.ndarray preprocess_adaptive_threshold(image: np.ndarray)", "description": "Prepares an image for OCR by converting it to grayscale, equalizing histogram, and applying adaptive thresholding.", "scope": "", "scopeKind": ""}, {"name": "float _avg_y_from_box(box: List[Tuple[float, float]])", "description": "Calculates the average Y coordinate of an OCR box using numpy for speed.", "scope": "", "scopeKind": ""}, {