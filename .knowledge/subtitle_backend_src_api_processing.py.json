{"is_source_file": true, "format": "Python", "description": "This file provides utilities and functions for processing various subtitle formats (SRT, ASS, SSA, VTT) by performing OCR on video frames to determine subtitle positioning (top or bottom). It includes mechanisms for caching, parallel processing, and normalizing subtitle alignment tags. The main function `process_subtitle` orchestrates the processing of a subtitle file against a video, adjusting alignment tags based on detected subtitles via OCR.", "external_files": ["cv2", "numpy", "srt"], "external_methods": ["RapidOCR"], "published": ["process_subtitle"], "classes": [{"name": "VideoContext", "description": "Encapsulates a reusable OpenCV VideoCapture object for efficient frame access and stores cached properties like FPS and frame count."}], "methods": [{"name": "cv2.VideoCapture _safe_video_capture(path: str)", "description": "Creates and returns a cv2.VideoCapture object, ensuring the video can be opened.", "scope": "", "scopeKind": ""}, {"name": "detect_using_rapidocr(img: np.ndarray)", "description": "Performs OCR detection on an image using RapidOCR, returning detected text regions.", "scope": "", "scopeKind": ""}, {"name": "str to_ass_timestamp_from_timedelta(td: timedelta)", "description": "Converts a timedelta object to the ASS subtitle timestamp string format.", "scope": "", "scopeKind": ""}, {"name": "np.ndarray preprocess_adaptive_threshold(image: np.ndarray)", "description": "Prepares an image for OCR by converting to grayscale, equalizing histogram, and applying adaptive thresholding.", "scope": "", "scopeKind": ""}, {"name": "float _avg_y_from_box(box: List[Tuple[float, float]])", "description": "Computes the average y-coordinate from a quadrilateral OCR bounding box efficiently with numpy.", "scope": "", "scopeKind": ""}, {"name": "str decide_subtitle_position(filtered_detections_list, frame_height: int, bottom_threshold_ratio: float = 0.75)", "description": "Determines whether subtitles s