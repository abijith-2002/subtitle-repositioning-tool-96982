{"is_source_file": true, "format": "Python", "description": "This source file contains a comprehensive implementation for subtitle repositioning in videos. It includes components for video frame extraction, OCR detection via RapidOCR, subtitle parsing and rewriting in multiple formats (SRT, ASS, SSA, VTT), and logic for determining subtitle positions (top or bottom) based on detected in-frame text. The code also manages threading and environment configurations to mitigate multi-threading issues with external libraries such as OpenCV, FFmpeg, and ONNXRuntime.", "external_files": ["cv2", "numpy", "re", "logging", "threading", "concurrent.futures", "typing", "srt", "datetime", "rapidocr_onnxruntime"], "external_methods": ["cv2.setNumThreads", "cv2.VideoCapture", "cv2.setNumThreads", "np.linspace", "np.clip", "srt.parse", "re.match", "re.search", "re.sub", "codecs.open", "logging.basicConfig", "logging.getLogger", "threading.local", "concurrent.futures.ThreadPoolExecutor", "concurrent.futures.as_completed", "time.time"], "published": ["process_subtitle"], "classes": [{"name": "VideoContext", "description": "A wrapper around OpenCV's VideoCapture for efficient frame reading and seeking with thread safety, to prevent FFmpeg decoding issues."}], "methods": [{"name": "_get_ocr_engine()", "description": "Creates or retrieves a thread-local RapidOCR engine instance to optimize OCR inference without cross-thread conflicts.", "scope": "", "scopeKind": ""}, {"name": "List[Dict[str,Any]] detect_using_rapidocr(img: np.ndarray)", "description": "Runs OCR detection on a preprocessed image, returning detected text boxes with confidence scores.", "scope": "", "scopeKind": ""}, {"name": "str _ass_ts_from_timedelta(td: timedelta)", "description": "Converts timedelta objects into ASS subtitle time string format.", "scope": "", "scopeKind": ""}, {"name": "np.ndarray preprocess_adaptive_threshold(image: np.ndarray)", "description": "Prepares images for OCR by converting to grayscale and ap